{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-preview?slug=:slug"
    },
    {
      "source": "/community/blog/:slug",
      "destination": "/api/blog-preview?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
