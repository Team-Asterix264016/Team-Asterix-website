{
  "name": "asterix_website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"CLIENT,SERVER\" -c \"cyan.bold,magenta.bold\" \"vite\" \"node server/src/index.js\"",
    "dev:watch": "concurrently -n \"CLIENT,SERVER\" -c \"cyan.bold,magenta.bold\" \"vite\" \"node --watch server/src/index.js\"",
    "dev:frontend": "vite",
    "dev:backend": "node server/src/index.js",
    "server": "node server/src/index.js",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"index.html\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"index.html\""
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.1.1",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vite": "^8.2.0"
  }
}
