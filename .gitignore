# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables
.env
.env.*
!.env.example

# Database and SQLite runtime files
*.db
*.db-journal
*.db-wal
*.db-shm
server/data/*.db*
!server/data/.gitkeep

# User uploaded dynamic media (keep default gallery)
server/uploads/*
!server/uploads/gallery/
!server/uploads/.gitkeep

# Source footage for the intro sequence. The extracted frames in public/intro
# are committed instead; regenerate them with scripts/extract-intro-frames.ps1.
media/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Claude Code settings (may hold connection strings)
.claude/settings.local.json

# Participant data dumps: PII, never commit
server/data/backups/

# Participant data for the one-off registration loaders. This repo is public
# and these files carry students names, emails and phone numbers.
server/src/scripts/data/
