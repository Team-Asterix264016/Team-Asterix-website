PORT=5000

# Required in production. There is no hardcoded fallback any more: if this is
# unset the server still starts, but signs with a random key generated at boot,
# so every admin session ends on restart.
JWT_SECRET=your_jwt_secret_key_here

# Enforced. An origin not listed here (and not a *asterix*.vercel.app preview)
# is refused.
CORS_ORIGIN=http://localhost:5173,https://asterix-website.vercel.app

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/asterix?retryWrites=true&w=majority
# Database to use. Unset = "asterix" (the database name in the URI is ignored).
# MONGODB_DB_NAME=asterix_workshop

# One-time bootstrap for the first administrator, replacing the hardcoded
# credentials that used to be accepted. With this set, signing in as
# ADMIN_BOOTSTRAP_USERNAME (default "admin") with this exact password creates
# that account if it does not already exist. Unset it once the account exists.
# The alternative is: node src/scripts/setAdminPassword.js '<password>'
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=

# ImageKit CDN Integration for Photo Uploads
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_imagekit_id>

# Razorpay (workshop payments). Use TEST MODE keys (rzp_test_...) from
# Dashboard -> Account & Settings -> API Keys. The key secret stays on the
# server; never put it in the front end or commit a real value.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Secret you choose when adding the webhook in Dashboard -> Webhooks
# (URL: https://<api-host>/api/workshop/webhook, events: payment.captured,
# payment.failed). This is a separate value from the key secret.
# Can be added after the site is hosted: until then the webhook replies 503
# "Webhook not configured" and payments still confirm through the checkout
# callback. Placeholder values like the ones in this file count as unset.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# WhatsApp Cloud API activity alerts (optional; leave unset to disable).
# Requires an approved WhatsApp Business template with one body variable, e.g.
# "Website alert: {{1}}", and an opted-in recipient number in international format.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TO=
WHATSAPP_TEMPLATE_NAME=website_change_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_API_VERSION=

# Optional custom persistent paths for cloud hosts (e.g. /var/data, /var/data/uploads)
# DATA_DIR=/var/data
# UPLOADS_DIR=/var/data/uploads

# Uploads refuse to write to local disk unless that disk actually survives a
# deploy. UPLOADS_DIR above (a mounted volume) is the production answer; this
# flag is the local-development one, where the disk is your own machine.
# Without ImageKit credentials and without either of these, POST /api/upload
# returns 503 rather than saving a file that the next deploy deletes.
# ALLOW_LOCAL_UPLOADS=true


